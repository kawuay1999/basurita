{
  "name": "frontend-movil",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4300 --ssl",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "apk": "node scripts/ip-apk.mjs && ng build --configuration apk && npx cap sync android && cd android && .\\gradlew.bat assembleDebug",
    "android": "node scripts/ip-apk.mjs && ng build --configuration apk && npx cap sync android && npx cap open android"
  },
  "private": true,
  "packageManager": "npm@11.21.1",
  "dependencies": {
